{
  "description": "am-auto stage guard: checks the tools and final answer of am-auto:agent stage agents, and runs the commit gate for an allowed shell command",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('url').pathToFileURL(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/stage-hook.mjs')).then((m) => m.main())\"",
            "timeout": 900
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('url').pathToFileURL(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/stage-hook.mjs')).then((m) => m.main())\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('url').pathToFileURL(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/stage-hook.mjs')).then((m) => m.main())\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
